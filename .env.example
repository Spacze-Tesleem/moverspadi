# Copy this file to .env.local for local development.
# In Vercel, set these under Project → Settings → Environment Variables.

# Required: URL of the backend API (no trailing slash).
# The Next.js rewrite maps /backend/* → NEXT_PUBLIC_API_URL/api/*
# so all browser requests stay same-origin and avoid CORS.
#
# Production (Render):  https://moverspadi.onrender.com
# Local backend:        http://localhost:3001
NEXT_PUBLIC_API_URL=https://moverspadi.onrender.com

# Optional: demo account credentials shown on the login page.
# If unset, the demo buttons use a fully offline session (no backend needed).
# Admin is intentionally excluded — admin access requires direct login.
NEXT_PUBLIC_DEMO_CUSTOMER_ID=
NEXT_PUBLIC_DEMO_CUSTOMER_PW=
NEXT_PUBLIC_DEMO_MOVER_ID=
NEXT_PUBLIC_DEMO_MOVER_PW=
NEXT_PUBLIC_DEMO_COMPANY_ID=
NEXT_PUBLIC_DEMO_COMPANY_PW=
