{
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://moverspadi.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/noise.svg",
      "headers": [
        { "key": "Content-Type", "value": "image/svg+xml" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
